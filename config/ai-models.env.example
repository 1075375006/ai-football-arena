# 复制为 config/ai-models.env 后填写。
# 该文件只给服务端读取，严禁提交真实 API Key 到 Git 或发送给前端。
# API_KEY_ENV 优先于 API_KEY；推荐把密钥放在系统环境变量中。
# 例如：API_KEY_ENV=OPENROUTER_API_KEY，并在项目根目录 .env 设置 OPENROUTER_API_KEY。

AI_MODEL_1_ID=gpt-5
AI_MODEL_1_NAME=GPT-5
AI_MODEL_1_PROVIDER=openai-compatible
AI_MODEL_1_BASE_URL=https://api.openai.com/v1
AI_MODEL_1_MODEL=gpt-5
AI_MODEL_1_API_KEY_ENV=OPENAI_API_KEY
AI_MODEL_1_API_KEY=
AI_MODEL_1_ENABLED=true
AI_MODEL_1_TIMEOUT_MS=30000
AI_MODEL_1_MAX_TOKENS=1800

AI_MODEL_2_ID=deepseek-r1
AI_MODEL_2_NAME=DeepSeek R1
AI_MODEL_2_PROVIDER=openai-compatible
AI_MODEL_2_BASE_URL=https://api.deepseek.com/v1
AI_MODEL_2_MODEL=deepseek-reasoner
AI_MODEL_2_API_KEY_ENV=DEEPSEEK_API_KEY
AI_MODEL_2_API_KEY=
AI_MODEL_2_ENABLED=true
AI_MODEL_2_TIMEOUT_MS=60000
AI_MODEL_2_MAX_TOKENS=3000

# Anthropic 示例：
# AI_MODEL_3_PROVIDER=anthropic
# AI_MODEL_3_BASE_URL=https://api.anthropic.com/v1
# AI_MODEL_3_MODEL=claude-sonnet-4-20250514
# AI_MODEL_3_API_KEY_ENV=ANTHROPIC_API_KEY

# Gemini 示例：
# AI_MODEL_4_PROVIDER=gemini
# AI_MODEL_4_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_MODEL_4_MODEL=gemini-2.5-pro
# AI_MODEL_4_API_KEY_ENV=GEMINI_API_KEY
